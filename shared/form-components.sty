% form-components.sty
% Reusable interactive PDF field macros and shared content blocks
% (document control, revision history, acknowledgement) for the
% engineering project intake document family.
%
% Depends on hyperref (loaded by intake-style.sty), which must be
% loaded before this package.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{form-components}[2026/10/09 v0.2 Engineering intake form components]

\RequirePackage{hyperref}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{etoolbox}% provides \ifstrempty, used to skip empty field labels
\RequirePackage{tabularx}% lets fillable-field tables stretch to fill \textwidth exactly

% Proportional stretch column for tabularx: \newcolumntype{Y}{<factor>} sets
% a column whose share of the table's stretch width is <factor> times the
% default X share, so columns can be given unequal widths while the table
% as a whole still always sums exactly to \textwidth.
\newcolumntype{Y}[1]{>{\hsize=#1\hsize\linewidth=\hsize\raggedright\arraybackslash}X}

% ---------------------------------------------------------------------------
% Field-name prefix. Set once per document (e.g. \SetFieldPrefix{intake}) so
% that combining several documents into one PDF package does not collide
% field names between documents.
% ---------------------------------------------------------------------------
\newcommand{\FormFieldPrefix}{doc}
\newcommand{\SetFieldPrefix}[1]{\renewcommand{\FormFieldPrefix}{#1}}

\newcommand{\FieldBorderColor}{0.45 0.45 0.45}
\newcommand{\FieldBackColor}{1 1 1}

% ---------------------------------------------------------------------------
% \TextLine{name}{label}{width}
% One-line fillable text field, label placed above the box (omitted if the
% label is empty), the whole thing wrapped in a parbox of the given width
% so it never overflows a surrounding table cell. Pass \linewidth as the
% width to make the field fill all of its available space (full \textwidth
% at the top level, or the full column width inside a tabularx cell).
% ---------------------------------------------------------------------------
\newcommand{\TextLine}[3]{%
  \parbox[t]{#3}{%
    \ifstrempty{#2}{}{\small #2:\\[2pt]}%
    \TextField[name=\FormFieldPrefix#1, width=#3, height=0.42cm,
         bordercolor={\FieldBorderColor}, backgroundcolor={\FieldBackColor}]{}%
  }%
}

% ---------------------------------------------------------------------------
% \TextArea{name}{label}{width}{height}
% Multi-line fillable text field, label placed above the box (omitted if the
% label is empty), wrapped in a parbox of the given width. Pass \linewidth
% as the width to fill all available space.
% ---------------------------------------------------------------------------
\newcommand{\TextArea}[4]{%
  \parbox[t]{#3}{%
    \ifstrempty{#2}{}{\small #2:\\[2pt]}%
    \TextField[name=\FormFieldPrefix#1, width=#3, height=#4, multiline=true,
         bordercolor={\FieldBorderColor}, backgroundcolor={\FieldBackColor}]{}%
  }%
}

% ---------------------------------------------------------------------------
% \CheckOption{name}{label}
% Checkbox with trailing label, for use in a list of options.
% ---------------------------------------------------------------------------
\newcommand{\CheckOption}[2]{%
  \CheckBox[name=\FormFieldPrefix#1, width=10pt, height=10pt,
       bordercolor={\FieldBorderColor}]{}~#2%
}

% ---------------------------------------------------------------------------
% \DropDown{name}{label}{width}{comma,separated,choices}
% Combo-box selection field, wrapped in a sized parbox like \TextLine.
% ---------------------------------------------------------------------------
\newcommand{\DropDown}[4]{%
  \parbox[t]{#3}{%
    \ifstrempty{#2}{}{\small #2:\\[2pt]}%
    \ChoiceMenu[name=\FormFieldPrefix#1, combo, width=#3,
         bordercolor={\FieldBorderColor}, backgroundcolor={\FieldBackColor}]{}{#4}%
  }%
}

% ---------------------------------------------------------------------------
% Document control block: shared, recurring identically across every
% document in the family (per design decision B1/B8). Call once near the
% top of each document, after \CoverPage.
% ---------------------------------------------------------------------------
\newcommand{\DocumentControlBlock}{%
  \IntakeSection{Document Control}
  \Guidance{Complete this block when the form is issued and update it each
  time the record is revised. The Intake Reference Number is independent of
  any project charge code and stays the same across every later document for
  this request.}\\[4pt]
  \begin{tabularx}{\textwidth}{XXX}
    \TextLine{CtrlIntakeRef}{Intake Reference No.}{\linewidth} &
    \DropDown{CtrlStatus}{Status}{\linewidth}{Draft,Under Review,Confirmed} &
    \TextLine{CtrlTemplateVer}{Template Version}{\linewidth} \\[10pt]
    \TextLine{CtrlRevision}{Current Revision}{\linewidth} &
    \TextLine{CtrlRevDate}{Revision Date}{\linewidth} &
    \TextLine{CtrlPreparer}{Prepared By}{\linewidth} \\
  \end{tabularx}
  \vspace{6pt}

  \Guidance{Revision history -- add a row each time the record changes after
  initial completion.}\\[4pt]
  \begin{tabularx}{\textwidth}{Y{0.12}Y{0.24}Y{0.18}Y{0.46}}
    \toprule
    Rev. & Author & Date & Change Summary \\
    \midrule
    \TextLine{RevHistRev1}{}{\linewidth} &
      \TextLine{RevHistAuth1}{}{\linewidth} &
      \TextLine{RevHistDate1}{}{\linewidth} &
      \TextLine{RevHistSumm1}{}{\linewidth} \\[8pt]
    \TextLine{RevHistRev2}{}{\linewidth} &
      \TextLine{RevHistAuth2}{}{\linewidth} &
      \TextLine{RevHistDate2}{}{\linewidth} &
      \TextLine{RevHistSumm2}{}{\linewidth} \\[8pt]
    \TextLine{RevHistRev3}{}{\linewidth} &
      \TextLine{RevHistAuth3}{}{\linewidth} &
      \TextLine{RevHistDate3}{}{\linewidth} &
      \TextLine{RevHistSumm3}{}{\linewidth} \\
    \bottomrule
  \end{tabularx}
  \vspace{4pt}
  \ContinuationNote
}

% ---------------------------------------------------------------------------
% Requesting organization and contacts block: shared, recurring identically
% across documents (per design decision B2).
% ---------------------------------------------------------------------------
\newcommand{\RequestingOrgBlock}{%
  \IntakeSection{Requesting Organization and Contacts}
  \TextLine{OrgDept}{Requesting Department / Program}{\linewidth}
  \vspace{10pt}

  \begin{tabularx}{\textwidth}{XX}
    \TextLine{OrgSponsor}{Sponsor}{\linewidth} &
    \TextLine{OrgSponsorContact}{Sponsor Email / Phone}{\linewidth} \\[10pt]
    \TextLine{OrgTechLead}{Technical Contact}{\linewidth} &
    \TextLine{OrgTechContact}{Technical Contact Email / Phone}{\linewidth} \\
  \end{tabularx}
  \vspace{4pt}
  \Guidance{List any additional people who can decide requirements or approve
  scope changes.}\\[2pt]
  \begin{tabularx}{\textwidth}{XX}
    \TextLine{OrgOther1Name}{Additional Contact}{\linewidth} &
    \TextLine{OrgOther1Role}{Role}{\linewidth} \\[10pt]
    \TextLine{OrgOther2Name}{Additional Contact}{\linewidth} &
    \TextLine{OrgOther2Role}{Role}{\linewidth} \\
  \end{tabularx}
  \vspace{4pt}
  \ContinuationNote
}

% ---------------------------------------------------------------------------
% Acknowledgement block: shared visual style; wording text is passed in so
% each document can use acknowledgement language appropriate to its stage.
% ---------------------------------------------------------------------------
\newcommand{\AcknowledgementBlock}[1]{%
  \IntakeSection{Acknowledgement}
  \Guidance{#1}\\[8pt]
  \begin{tabularx}{\textwidth}{XX}
    \TextLine{AckReqName}{Requester Name}{\linewidth} &
    \TextLine{AckReqDate}{Date}{\linewidth} \\[10pt]
    \TextLine{AckCenterName}{Center Reviewer Name}{\linewidth} &
    \TextLine{AckCenterDate}{Date}{\linewidth} \\
  \end{tabularx}
}

% ---------------------------------------------------------------------------
% \OpenItemsTable{prefix}
% Three-row open-item / owner / target-date table, reused identically across
% documents (first used on the Intake Form, reused on the Scope Definition
% Worksheet). The prefix argument keeps field names unique when a document
% needs more than one open-items table (e.g. "Open" vs "ScopeOpen").
% ---------------------------------------------------------------------------
\newcommand{\OpenItemsTable}[1]{%
  \begin{tabularx}{\textwidth}{Y{0.5}Y{0.27}Y{0.23}}
    \toprule
    Open Item & Owner & Target Date \\
    \midrule
    \TextLine{#1Item1}{}{\linewidth} & \TextLine{#1Owner1}{}{\linewidth} & \TextLine{#1Date1}{}{\linewidth} \\[8pt]
    \TextLine{#1Item2}{}{\linewidth} & \TextLine{#1Owner2}{}{\linewidth} & \TextLine{#1Date2}{}{\linewidth} \\[8pt]
    \TextLine{#1Item3}{}{\linewidth} & \TextLine{#1Owner3}{}{\linewidth} & \TextLine{#1Date3}{}{\linewidth} \\
    \bottomrule
  \end{tabularx}\\[4pt]
  \ContinuationNote
}

\endinput
