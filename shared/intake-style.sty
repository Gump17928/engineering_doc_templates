% intake-style.sty
% Shared branding, page layout, headers/footers, and document-identity macros
% for the engineering project intake document family.
%
% Edit this file to update branding/markings for every document at once.
% Do not put document-specific content here.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{intake-style}[2026/10/09 v0.1 Engineering intake shared style]

\RequirePackage[letterpaper, margin=1in, headheight=50pt, footskip=30pt]{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{array}
\RequirePackage{booktabs}
\RequirePackage{lastpage}
\RequirePackage{etoolbox}% provides \ifdefempty, used for the logo-vs-text header switch
\RequirePackage[
  pdfborder={0 0 0},
  colorlinks=false
]{hyperref}

% ---------------------------------------------------------------------------
% Branding placeholders -- replace with the organization's actual values.
% ---------------------------------------------------------------------------
\newcommand{\CompanyName}{[Company / Center Name]}
\newcommand{\CompanyLogoPath}{}% e.g. {shared/logo.png}; left blank until a real logo is supplied
\newcommand{\MarkingText}{FOR OFFICIAL USE ONLY -- CONTENTS CONFIDENTIAL}

\newcommand{\SetCompanyName}[1]{\renewcommand{\CompanyName}{#1}}
\newcommand{\SetCompanyLogo}[1]{\renewcommand{\CompanyLogoPath}{#1}}
\newcommand{\SetMarkingText}[1]{\renewcommand{\MarkingText}{#1}}

% ---------------------------------------------------------------------------
% Document identity -- set once near the top of each document entry file
% via \SetDocIdentity{Title}{Document ID}{Template Version}.
% ---------------------------------------------------------------------------
\newcommand{\DocTitle}{Untitled Document}
\newcommand{\DocID}{DOC-000}
\newcommand{\TemplateVersion}{v0.1-draft}

\newcommand{\SetDocIdentity}[3]{%
  \renewcommand{\DocTitle}{#1}%
  \renewcommand{\DocID}{#2}%
  \renewcommand{\TemplateVersion}{#3}%
}

% ---------------------------------------------------------------------------
% Header / footer, applied identically to every document.
% ---------------------------------------------------------------------------
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}

\lhead{%
  \ifdefempty{\CompanyLogoPath}{%
    \small\textbf{\CompanyName}%
  }{%
    \includegraphics[height=0.35in]{\CompanyLogoPath}%
  }%
}
\chead{\small \MarkingText}
\rhead{\small \DocID\ (\TemplateVersion)}

\lfoot{\small \DocTitle}
\cfoot{\small \MarkingText}
\rfoot{\small Page \thepage\ of \pageref{LastPage}}

% ---------------------------------------------------------------------------
% Title block shown at the top of page 1 of every document.
% ---------------------------------------------------------------------------
\newcommand{\TitleBlock}{%
  \begin{center}
    {\LARGE \textbf{\DocTitle}}\\[4pt]
    {\small \CompanyName\ -- \DocID\ -- Template \TemplateVersion}
  \end{center}
  \vspace{6pt}
}

% ---------------------------------------------------------------------------
% Section heading helper: bold, numbered-by-use, with a thin rule underneath.
% ---------------------------------------------------------------------------
\newcommand{\IntakeSection}[1]{%
  \vspace{10pt}%
  {\large \textbf{#1}}\\[-4pt]
  \hrule
  \vspace{6pt}%
}

% ---------------------------------------------------------------------------
% Persistent guidance text (small, italic) -- stays visible next to a field
% rather than disappearing once the field is filled in.
% ---------------------------------------------------------------------------
\newcommand{\Guidance}[1]{{\small\itshape #1}}

% ---------------------------------------------------------------------------
% Continuation-sheet note for items that may exceed the fixed inline rows.
% ---------------------------------------------------------------------------
\newcommand{\ContinuationNote}{%
  \Guidance{If more rows are needed, attach a continuation sheet listing the
  same columns and reference it here by name.}%
}

\endinput
